---
interface Props {
  status: 'свободно' | 'запазено' | 'осиновено';
}
const { status } = Astro.props;

const styles: Record<string, string> = {
  'свободно': 'bg-sage text-white',
  'запазено': 'bg-peach text-brown',
  'осиновено': 'bg-rose text-white',
};
---

<span class={`inline-block whitespace-nowrap px-3 py-1 rounded-full text-sm font-heading ${styles[status]}`}>
  {status}
</span>
